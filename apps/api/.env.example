GPT_AUTO_DATABASE_URL=
GPT_AUTO_ENVIRONMENT=development
GPT_AUTO_AUTHENTICATION_ENABLED=true
GPT_AUTO_COOKIE_SECURE=false
GPT_AUTO_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GPT_AUTO_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
GPT_AUTO_LOG_LEVEL=INFO
# 可选：仅在需要临时回退到其他协议运行时目录时覆盖
# GPT_AUTO_LEGACY_RUNTIME_PATH=/absolute/path/to/runtime

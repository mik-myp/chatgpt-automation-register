# Image tag or digest to deploy.
GPT_AUTO_IMAGE=mikmyp/chatgpt-automation-register:latest
APP_PORT=8000

# Required by compose.yaml. Use a long random value and URL-encode reserved URL characters.
POSTGRES_PASSWORD=

# Public HTTPS origin and reverse-proxy host. Comma-separated values are supported.
TRUSTED_ORIGINS=https://register.example.com
TRUSTED_HOSTS=register.example.com
COOKIE_SECURE=true

# Set this to the reverse proxy address or CIDR only when proxy headers are required.
FORWARDED_ALLOW_IPS=127.0.0.1

# The master key is created at /app/data/master.key with mode 0600.
# To use a Docker Secret, mount it read-only and set:
# GPT_AUTO_MASTER_KEY_FILE=/run/secrets/gpt_auto_master_key
